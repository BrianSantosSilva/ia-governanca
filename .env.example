NODE_ENV=development
LOG_LEVEL=info
DATA_RETENTION_DAYS=3650

DATABASE_URL=postgres://app:app_dev_password@localhost:5432/ai_spend

OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
# Opcionais: contexto do Ollama (o padr√£o de 4096 trunca prompts de agentes) e camadas na GPU (0 = s√≥ CPU/RAM)
OLLAMA_NUM_CTX=32768
OLLAMA_NUM_GPU=0

LLM_DEFAULT_PROVIDER=ollama
LLM_EXTERNAL_PROVIDERS_ENABLED=false
GEMINI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
CONNECTOR_CREDENTIALS_KEY=
PROMPT_CONTENT_ENCRYPTION_KEY=

APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3001
API_PORT=3001
API_RATE_LIMIT_MAX=120
GATEWAY_BASE_URL=http://localhost:3002
GATEWAY_INTERNAL_URL=http://localhost:3002
GATEWAY_PORT=3002
GATEWAY_RATE_LIMIT_MAX=120
WORKER_PORT=3003

KEYCLOAK_BASE_URL=http://localhost:8080
KEYCLOAK_REALM=ai-spend
KEYCLOAK_CLIENT_ID=ia-governanca-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password

VITE_API_BASE_URL=http://localhost:3001
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=ai-spend
VITE_KEYCLOAK_CLIENT_ID=ia-governanca-web

# AutenticaÁ„o (10.8): local, oidc ou both. Sem KEYCLOAK_BASE_URL o padr„o È local.
#AUTH_MODE=both
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
#AUTH_LOCAL_JWT_SECRET=
# Primeiro administrador local (opcional; exige troca de senha no primeiro login)
#BOOTSTRAP_ADMIN_EMAIL=admin@example.local
#BOOTSTRAP_ADMIN_PASSWORD=
